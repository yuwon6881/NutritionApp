{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self' https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://nutrition-api-396431756440.asia-southeast1.run.app/api/$1",
      "headers": { "Cache-Control": "no-store", "Vercel-CDN-Cache-Control": "no-store" }
    },
    { "src": "/health", "dest": "https://nutrition-api-396431756440.asia-southeast1.run.app/health", "headers": { "Cache-Control": "no-store" } },
    { "src": "/(?:sw\\.js|index\\.html|manifest\\.webmanifest|)", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/coach", "dest": "/index.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "status": 404 }
  ]
}
