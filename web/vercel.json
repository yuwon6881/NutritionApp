{
  "routes": [
    {
      "src": "/open/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/open/coach/?",
      "status": 308,
      "headers": {
        "Location": "/coach"
      }
    },
    {
      "src": "/open/settings/?",
      "status": 308,
      "headers": {
        "Location": "/settings"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "https://nutrition-api-781492578254.asia-southeast1.run.app/api/$1",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|internal/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "dest": "/index.html"
    }
  ]
}
