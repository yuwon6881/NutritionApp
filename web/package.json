{
  "name": "nutrition-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5088 --strictPort",
    "test": "vitest run --maxWorkers=1",
    "test:visual": "npm run build && playwright test",
    "typecheck": "tsc -b",
    "check:standards": "node ../scripts/check-standards.mjs",
    "check:docs": "node ../scripts/sync-docs.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@zxing/browser": "0.1.5",
    "lucide-react": "0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
