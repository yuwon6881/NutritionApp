{
  "name": "nutrition-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5088 --strictPort",
    "test": "vitest run --maxWorkers=1",
    "test:visual": "npm run build && playwright test",
    "android:sync": "npm run build && npm run check:android-firebase && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "typecheck": "tsc -b",
    "check:android-firebase": "node scripts/check-android-firebase.mjs",
    "check:standards": "node ../scripts/check-standards.mjs",
    "check:docs": "node ../scripts/sync-docs.mjs --check"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/push-notifications": "8.1.1",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@zxing/browser": "0.1.5",
    "firebase": "^11.10.0",
    "lucide-react": "0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
