{
  "name": "nutrition-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "NODE_ENV=production npm --prefix web run build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "npm --prefix web run typecheck && node scripts/check-standards.mjs && node scripts/sync-docs.mjs --check"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-react": "6.0.1",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0"
  }
}
